{
  "name": "public-damage-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Public Infrastructure Damage Reporting System + Women Entrepreneur Marketplace",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "test:smoke": "npm run test:smoke --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}