# API base URL. Leave as /api to use the Vite dev proxy.
# For production, point this at your deployed API, e.g. https://api.example.com/api
VITE_API_URL=/api

# Optional: override the browser executable used by the E2E suite.
# If unset, the suite probes the standard Chrome/Chromium install locations.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Optional: override the app URL the E2E suite drives.
# E2E_BASE_URL=http://localhost:3000